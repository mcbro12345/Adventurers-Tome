rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function admin() { return signedIn() && me() == 'matthewcbro@gmail.com'; }
    // Who may open a character: its owner, anyone it's shared with, and the DM. Editors may also change it, but not who owns it or who it's shared with.
    function canSee(d) { return d.owner == me() || me() in d.viewers; }
    function ownerWrite() { return resource.data.owner == me() && request.resource.data.owner == me(); }
    function editorWrite() { return me() in resource.data.editors
      && request.resource.data.owner == resource.data.owner
      && request.resource.data.viewers == resource.data.viewers
      && request.resource.data.editors == resource.data.editors; }
    function createOK() { return request.resource.data.owner == me() || me() in request.resource.data.editors; }
    match /sheets/{id} {
      allow get: if admin() || (signedIn() && (resource == null || canSee(resource.data)));
      allow create: if admin() || (signedIn() && createOK());
      allow update: if admin() || (signedIn() && (ownerWrite() || editorWrite()));
      allow list, delete: if false;
    }
    match /groups/{g} {
      allow get: if signedIn();
      allow create, update: if admin();
      allow list, delete: if false;
      match /chars/{c} {
        allow read: if admin() || (signedIn() && (resource == null || canSee(resource.data)));
        allow create: if admin() || (signedIn() && createOK());
        allow update: if admin() || (signedIn() && (ownerWrite() || editorWrite()));
        allow delete: if admin();
      }
    }
  }
}
