rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // The site owner, by their sign-in account id (not their email, so the rules hold no personal info).
    function ownerUid() { return request.auth != null && request.auth.uid == 'Ns3qDtOrAcNcJkZKHemhBedz9oA2'; }
    // Signed in, and not blocked or signed out everywhere by an admin (the site owner can never be locked out).
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true && accountOK(); }
    function accountOK() {
      let p = /databases/$(db)/documents/users/$(request.auth.token.email.lower());
      return ownerUid() || !exists(p)
        || (get(p).data.get('banned', false) != true && get(p).data.get('revokedAt', 0) <= request.auth.token.auth_time * 1000);
    }
    function me() { return request.auth.token.email.lower(); }
    function owner0() { return signedIn() && ownerUid(); }
    function admin() { return owner0() || (signedIn() && exists(/databases/$(db)/documents/config/admins)
      && me() in get(/databases/$(db)/documents/config/admins).data.emails); }
    // Who may open a character: its owner, anyone it's shared with, and the DM. Editors may also change it, but not who owns it or who it's shared with.
    function canSee(d) { return d.owner == me() || me() in d.viewers; }
    function ownerWrite() { return resource.data.owner == me() && request.resource.data.owner == me(); }
    function editorWrite() { return me() in resource.data.editors
      && request.resource.data.owner == resource.data.owner
      && request.resource.data.viewers == resource.data.viewers
      && request.resource.data.editors == resource.data.editors; }
    // Relinquish access: someone it's shared with may take themselves off the share list, and change nothing else.
    function leaveWrite() { return me() in resource.data.viewers
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'editors'])
      && request.resource.data.viewers == resource.data.viewers.removeAll([me()])
      && request.resource.data.get('editors', []) == resource.data.get('editors', []).removeAll([me()]); }
    // A new character is always your own. The one exception: an editor saving a big character adds its extra pieces
    // (<id>_p1, _p2...), which belong to the same owner as the main one.
    function mainOf(id) { return get(/databases/$(db)/documents/sheets/$(id.replace('_p[0-9]+$', ''))).data; }
    function createOK(id) { return (request.resource.data.owner == me() && (!id.matches('.+_p[0-9]+') || !exists(/databases/$(db)/documents/sheets/$(id.replace('_p[0-9]+$', ''))) || mainOf(id).owner == me()))
      || (id.matches('.+_p[0-9]+') && me() in mainOf(id).get('editors', []) && request.resource.data.owner == mainOf(id).owner); }
    // Character ids are plain letters, digits, - and _ (they end up in addresses and on the page).
    function idOK(id) { return id.matches('[A-Za-z0-9_-]{1,80}'); }
    // A party's DM (and anyone the DM made a co-DM) can look at - not change - the characters in their party.
    // The character says which party it's in; the party has to list it too.
    function partyView(id, d) { return d.get('party', '') is string && d.get('party', '') != '' && partyMgr(get(/databases/$(db)/documents/parties/$(d.party)).data)
      && (id in get(/databases/$(db)/documents/parties/$(d.party)).data.chars || id.replace('_p[0-9]+$', '') in get(/databases/$(db)/documents/parties/$(d.party)).data.chars); }
    // The party's DM applying what they sent to a character nobody has open (healing, an item, a spell...); other
    // players' changes wait in the inbox for the character's player to accept:
    // only the character's saved data changes - never who owns it, who it's shared with, or which party it's in.
    function partyWrite(id) { let d = resource.data; return d.get('party', '') is string && d.get('party', '') != ''
      && partyMgr(get(/databases/$(db)/documents/parties/$(d.party)).data)
      && (id in get(/databases/$(db)/documents/parties/$(d.party)).data.chars || id.replace('_p[0-9]+$', '') in get(/databases/$(db)/documents/parties/$(d.party)).data.chars)
      && request.resource.data.diff(d).affectedKeys().hasOnly(['data', 'savedAt', 'tab', 'n']); }
    // A character in a party is shared with the party's DM and co-DMs (can edit), as if its player had shared it; the party
    // remembers what it granted (pshare: added as viewer and editor, pedit: made an editor) so only that is taken back when
    // the character leaves. A DM or co-DM may add themselves; the party's shares may be taken back by the DM, a co-DM or
    // anyone the party shared it with. Extra pieces of a big character (<id>_p1...) and its lobby card follow the main one.
    function isPart(id) { return id.matches('.+_p[0-9]+'); }
    function grows(k, who) { let o = resource.data.get(k, []); let n = request.resource.data.get(k, []); return o.removeAll(n).size() == 0 && n.removeAll(o).hasOnly(who); }
    function shrinks(k, ok) { let o = resource.data.get(k, []); let n = request.resource.data.get(k, []); return n.removeAll(o).size() == 0 && o.removeAll(n).hasOnly(ok); }
    function shareKeysOnly() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'editors', 'pshare', 'pedit']); }
    function partyGrant(id, d) { return shareKeysOnly() && partyView(id, d) && grows('viewers', [me()]) && grows('editors', [me()]) && grows('pshare', [me()]) && grows('pedit', [me()]); }
    function partyRevoke(id, d) { let given = d.get('pshare', []).concat(d.get('pedit', []));
      return shareKeysOnly() && (partyView(id, d) || me() in given)
        && shrinks('viewers', d.get('pshare', [])) && shrinks('editors', given) && shrinks('pshare', d.get('pshare', [])) && shrinks('pedit', d.get('pedit', [])); }
    // Everyone in the party can read a party member's saved character (to apply what they send when it isn't open).
    function partyRead(id, d) { return d.get('party', '') is string && d.get('party', '') != '' && me() in get(/databases/$(db)/documents/parties/$(d.party)).data.people
      && (id in get(/databases/$(db)/documents/parties/$(d.party)).data.chars || id.replace('_p[0-9]+$', '') in get(/databases/$(db)/documents/parties/$(d.party)).data.chars); }
    match /sheets/{id} {
      allow get: if admin() || (signedIn() && (resource == null || canSee(resource.data) || partyView(id, resource.data) || partyRead(id, resource.data)));
      allow create: if admin() || (signedIn() && idOK(id) && createOK(id));
      allow update: if admin() || (signedIn() && (ownerWrite() || editorWrite() || leaveWrite() || partyWrite(id) || (!isPart(id) && (partyGrant(id, resource.data) || partyRevoke(id, resource.data))) || (isPart(id) && (partyGrant(id, mainOf(id)) || partyRevoke(id, mainOf(id))))));
      // only the owner (or an admin) can delete a character - never someone it's merely shared with
      allow delete: if admin() || (signedIn() && resource.data.owner == me());
      allow list: if false;
    }
    // Who's viewing a sheet right now: anyone who can open the sheet can see the list; you can only write your own entry.
    match /sheets/{id}/presence/{em} {
      allow read: if admin() || (signedIn() && canSee(get(/databases/$(db)/documents/sheets/$(id)).data));
      allow write: if signedIn() && em == me() && (admin() || canSee(get(/databases/$(db)/documents/sheets/$(id)).data));
    }
    // Rolling from a phone through the same character open on a computer: requests and answers, and the computer that's ready.
    match /sheets/{id}/relay/{r} {
      allow read, delete: if signedIn() && canEditSheet(id);
      allow update: if signedIn() && canEditSheet(id) && request.resource.data.get('by', '') == resource.data.get('by', '');
      // a roll request (or the "computer ready" note) is always signed with who sent it
      allow create: if signedIn() && canEditSheet(id) && request.resource.data.by == me();
    }
    // One record per account, keyed by email: made by the person on first sign-in. Only that person and admins can
    // read it, and only admins can list or search them (names on shared characters come from the character itself).
    match /users/{em} {
      allow get: if admin() || (signedIn() && em == me());
      allow list: if admin();
      allow create: if admin() || (signedIn() && em == me() && request.resource.data.email == me()
        && request.resource.data.keys().hasOnly(['email', 'name', 'nameLower', 'keys', 'createdAt', 'seenAt', 'gpic']));
      allow update: if admin() || (signedIn() && em == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt', 'seenFg', 'pic', 'picChar', 'picColor', 'picClear', 'picMode', 'gpic', 'name', 'nameLower', 'keys', 'msgSeen', 'noticeSeen', 'welcomeSeen', 'partyOrder', 'seenPc', 'seenPhone', 'ext', 'extAt', 'extInst', 'extNag', 'pwaPhone', 'pwaPc'])
        && (!('pwaPhone' in request.resource.data) || request.resource.data.pwaPhone is number) && (!('pwaPc' in request.resource.data) || request.resource.data.pwaPc is number)
        && (!('extInst' in request.resource.data) || (request.resource.data.extInst is string && request.resource.data.extInst.size() <= 20))
        && (request.resource.data.get('extNag', 0) == 0 || request.resource.data.get('extNag', 0) == resource.data.get('extNag', 0))
        && (!('ext' in request.resource.data) || (request.resource.data.ext is string && request.resource.data.ext.size() <= 20))
        && (!('partyOrder' in request.resource.data) || (request.resource.data.partyOrder is list && request.resource.data.partyOrder.size() <= 200))
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 60);
      allow delete: if admin();
    }
    // Notices to everyone (the admin page's Notice tab): the log of every one sent. Each account's copy lives on its users record.
    match /notices/{n} {
      allow read, write: if admin();
    }
    // The address book: /zeebo -> which character. Anyone signed in can look an address up (it only says which character -
    // opening it still needs access). Only the character's owner (or an admin) can claim, keep or free its addresses.
    function ownsSheet(c) { return exists(/databases/$(db)/documents/sheets/$(c)) && get(/databases/$(db)/documents/sheets/$(c)).data.owner == me(); }
    match /slugs/{s} {
      allow get: if signedIn();
      allow list: if admin();
      allow create: if admin() || (signedIn() && request.resource.data.keys().hasOnly(['c']) && ownsSheet(request.resource.data.c));
      allow update: if admin() || (signedIn() && request.resource.data.keys().hasOnly(['c']) && request.resource.data.c == resource.data.c && ownsSheet(resource.data.c));
      allow delete: if admin() || (signedIn() && ownsSheet(resource.data.c));
    }
    // Activity log: anyone signed in can add their own entries; only admins can read it; nobody can change it; admins can delete events (old ones are cleared out, and the whole log can be emptied).
    match /audit/{id} {
      allow create: if signedIn() && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['at', 'by', 'byName', 'act', 'target', 'tName', 'detail'])
        && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 3600000 && request.resource.data.at >= request.time.toMillis() - 31536000000
        && request.resource.data.get('byName', '') is string && request.resource.data.get('byName', '').size() <= 120
        && request.resource.data.act is string && request.resource.data.act.matches('[a-z_]{1,40}')
        && request.resource.data.get('target', '') is string && request.resource.data.get('target', '').size() <= 200
        && request.resource.data.get('tName', '') is string && request.resource.data.get('tName', '').size() <= 200
        && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 1500;
      allow read: if admin();
      allow update: if false;
      allow delete: if admin();
    }
    // View-only links: a public copy of a sheet at pub/<random link id> (big sheets split as <id>_p1, _p2...). Anyone can open
    // one if they have the link; only someone who can edit the character can write or remove it. Links can't be listed.
    function canEditSheet(c) { let sh = get(/databases/$(db)/documents/sheets/$(c)).data;
      return admin() || (signedIn() && (sh.owner == me() || me() in sh.get('editors', []))); }
    match /pub/{t} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['c', 'savedAt', 'data', 'n', 'v', 'tab']) && request.resource.data.c is string && canEditSheet(request.resource.data.c);
      allow update: if request.resource.data.keys().hasOnly(['c', 'savedAt', 'data', 'n', 'v', 'tab']) && request.resource.data.c == resource.data.c && canEditSheet(resource.data.c);
      allow delete: if canEditSheet(resource.data.c);
    }
    // Who's viewing a character that has a view-only link. Anyone with the link can see it (it shows on the public page
    // too), and only while the link is on. Signed-in viewers add their own entry under a fingerprint of their email
    // (viewId), so the list never shows emails. People who aren't signed in aren't listed (anyone could add endless entries).
    // A signed-in viewer is listed as "u-" + the start of their email's SHA-256, never by email (the list is public).
    function viewId() { return 'u-' + hashing.sha256(me()).toHexString().lower().replace('^(.{24}).*$', '$1'); }
    function pubOnFor(c) { let s = /databases/$(db)/documents/sheets/$(c); return exists(s) && get(s).data.get('pub', '') != ''; }
    match /pubviews/{c}/live/{v} {
      allow read: if pubOnFor(c);
      allow create, update: if pubOnFor(c) && request.resource.data.at is number
        && request.resource.data.at > request.time.toMillis() - 3600000 && request.resource.data.at < request.time.toMillis() + 3600000
        && ((signedIn() && v == viewId() && request.resource.data.anon == false
            && request.resource.data.keys().hasOnly(['anon', 'at', 'name', 'pic', 'color', 'clear'])
            && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 60
            && request.resource.data.get('pic', '') is string && request.resource.data.get('pic', '').size() <= 60000 && request.resource.data.get('color', '') is string && request.resource.data.get('color', '').size() <= 20 && request.resource.data.get('clear', false) is bool));
      allow delete: if v.matches('anon-[a-z0-9]{6,16}') || (signedIn() && v == viewId());
    }
    // ================= Parties =================
    // parties/{p}: { name, dm, by, createdAt, updatedAt, chars (character ids), people (everyone who sees it in their
    // list: the players, the DM, co-DMs), mgrs (co-DMs), invited (emails asked to join), inv (the invite link's code,
    // '' when off), via, gone }. The DM and co-DMs run it; players join with the link (or an email invite) and can
    // bring only their own characters, and leave whenever they like. Admins can do anything.
    function partyMgr(pd) { return signedIn() && (me() == pd.dm || me() in pd.get('mgrs', [])); }
    function partyOf(p) { return get(/databases/$(db)/documents/parties/$(p)).data; }
    function lastChar() { return request.resource.data.chars[request.resource.data.chars.size() - 1]; }
    // Joining: one character of your own is added at the end, and you're added to the people who see the party.
    function joinOK() { let o = resource.data; let n = request.resource.data;
      return n.diff(o).affectedKeys().hasOnly(['chars', 'people', 'invited', 'via', 'updatedAt', 'inv'])
        && (n.get('inv', '') == o.get('inv', '') || (n.get('inv', '') == '' && n.get('via', '') == o.get('inv', '') && o.get('inv', '') != '' && get(invAt(o.inv)).data.get('max', 0) > 0 && getAfter(invAt(o.inv)).data.get('used', 0) >= get(invAt(o.inv)).data.get('max', 0)))
        && n.chars.size() == o.chars.size() + 1 && n.chars == o.chars.concat([lastChar()]) && !(lastChar() in o.chars) && ownsSheet(lastChar())
        && n.people.removeAll(o.people).hasOnly([me()]) && o.people.removeAll(n.people).size() == 0
        && (n.invited == o.invited || n.invited == o.invited.removeAll([me()]))
        && (me() in o.invited || partyMgr(o) || (n.via is string && n.via != '' && n.via == o.inv && linkOK(o.inv))); }
    function invAt(code) { return /databases/$(db)/documents/invites/$(code); }
    // An invite link with a set number of players stops working once that many have joined with it: joining with it counts
    // the player in the same write (and only the last one to join may turn the link off).
    function linkOK(code) { let iv = get(/databases/$(db)/documents/invites/$(code)).data; return iv.get('max', 0) == 0 || (iv.get('used', 0) < iv.get('max', 0) && getAfter(/databases/$(db)/documents/invites/$(code)).data.get('used', 0) == iv.get('used', 0) + 1); }
    // Leaving: take one of your own characters out (n.gone says which), and optionally yourself off the list.
    function leaveOK() { let o = resource.data; let n = request.resource.data;
      return n.diff(o).affectedKeys().hasOnly(['chars', 'people', 'gone', 'updatedAt']) && n.gone is string && n.gone in o.chars && ownsSheet(n.gone)
        && n.chars == o.chars.removeAll([n.gone]) && (n.people == o.people || n.people == o.people.removeAll([me()])); }
    // Taking yourself off the list (a co-DM stepping down), or turning an invitation down.
    function selfOffOK() { let o = resource.data; let n = request.resource.data;
      return me() != o.dm && (me() in o.people || me() in o.get('mgrs', []) || me() in o.invited) && n.diff(o).affectedKeys().hasOnly(['people', 'mgrs', 'invited', 'updatedAt'])
        && n.people == o.people.removeAll([me()]) && n.mgrs == o.mgrs.removeAll([me()]) && n.invited == o.invited.removeAll([me()]); }
    function declineOK() { let o = resource.data; let n = request.resource.data;
      return me() in o.invited && n.diff(o).affectedKeys().hasOnly(['invited']) && n.invited == o.invited.removeAll([me()]); }
    // The DM changes anything; characters come in one at a time (players join with their own). An admin can hand the
    // party to a new DM.
    // The DM can also add a character that's been shared with them (one at a time); its player then sees the party.
    function seesSheet(c) { let d = get(/databases/$(db)/documents/sheets/$(c)).data; return d.owner == me() || me() in d.get('viewers', []); }
    // Who the DM can put on the list (it decides who reads the players' chat): the player of a character being added, or a
    // new co-DM (co-DMs never read the chat). A co-DM who's taken off comes off the list too.
    function mgrOK() { let o = resource.data; let n = request.resource.data; let add = n.chars.removeAll(o.chars); let addP = n.people.removeAll(o.people);
      return partyMgr(o) && n.by == o.by && n.dm == o.dm && (me() == o.dm || n.mgrs == o.mgrs)
        && (add.size() == 0 || (add.size() == 1 && seesSheet(add[0])))
        && (addP.size() == 0 || (add.size() == 1 && addP.hasOnly([get(/databases/$(db)/documents/sheets/$(add[0])).data.owner])) || addP.hasOnly(n.get('mgrs', []).removeAll(o.get('mgrs', []))))
        && !n.people.hasAny(o.get('mgrs', []).removeAll(n.get('mgrs', []))); }
    match /parties/{p} {
      allow get: if admin() || (signedIn() && (me() in resource.data.people || me() in resource.data.invited || partyMgr(resource.data)));
      allow list: if admin() || (signedIn() && (me() in resource.data.people || me() in resource.data.invited));
      allow create: if signedIn() && request.resource.data.dm == me() && request.resource.data.by == me() && request.resource.data.chars.size() == 0
        && me() in request.resource.data.people && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow update: if admin() || (signedIn() && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.get('updatedAt', 0) is number && request.resource.data.get('via', '') is string && request.resource.data.get('via', '').size() <= 80
        && (mgrOK() || joinOK() || leaveOK() || selfOffOK() || declineOK()));
      allow delete: if admin() || (signedIn() && me() == resource.data.dm);
      // Each character's card (name, picture, HP, AC, conditions), kept up to date by the character's own sheet.
      match /cards/{c} {
        allow read: if admin() || (signedIn() && (me() in partyOf(p).people || partyMgr(partyOf(p))));
        // only the character's own player (or whoever can edit it) and the DM keep it up to date
        allow write: if admin() || (signedIn() && c in partyOf(p).chars && (canEditSheet(c) || partyMgr(partyOf(p))));
        allow delete: if signedIn() && partyMgr(partyOf(p));
      }
      // The party's own homebrew items (added by the DM, e.g. from the DM's Desk); everyone in the party can read them.
      match /hb/{h} {
        allow read: if admin() || (signedIn() && (me() in partyOf(p).people || partyMgr(partyOf(p))));
        allow create, update: if admin() || (signedIn() && partyMgr(partyOf(p)) && request.resource.data.keys().hasOnly(['item', 'name', 'at', 'by'])
          && request.resource.data.item is string && request.resource.data.item.size() <= 200000 && request.resource.data.name is string && request.resource.data.name.size() <= 120);
        allow delete: if admin() || (signedIn() && partyMgr(partyOf(p)));
      }
      // The DM's turn order while it's open, mirrored for the players' sheets (names and initiative; monsters' HP stays with the DM).
      match /turn/{t} {
        allow read: if admin() || (signedIn() && (me() in partyOf(p).people || partyMgr(partyOf(p))));
        allow write: if admin() || (signedIn() && partyMgr(partyOf(p)) && request.resource.data.keys().hasOnly(['open', 'round', 'rows', 'at', 'by'])
          && request.resource.data.rows is list && request.resource.data.rows.size() <= 60);
      }
      // Splitting loot: the DM puts a container's loot up for the party (split/{box}, its things in items/{id}); everyone in
      // the party sees it on their sheets and picks who gets what (to: a character in the party), and anyone with a
      // character in it can hand it out: each thing is marked handed (only once) by whoever sends it, then the split closes.
      // Only the DM writes anything else (what's in it, applied - taken out of the DM's loot).
      match /split/{b} {
        allow read: if admin() || (signedIn() && (me() in partyOf(p).people || partyMgr(partyOf(p))));
        allow write: if admin() || (signedIn() && partyMgr(partyOf(p)));
        // players: agree for a character of their own (ok), clear everyone's agreement when the picks change, and - once
        // everyone has agreed - hand it out (going: who's sending it, then open false)
        allow update: if signedIn() && me() in partyOf(p).people && resource.data.open == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok', 'rev', 'going', 'open', 'handedBy', 'handedAt'])
          && request.resource.data.get('ok', []) is list && request.resource.data.get('ok', []).size() <= 40
          && (request.resource.data.get('ok', []).removeAll(resource.data.get('ok', [])).size() == 0
            || (request.resource.data.get('ok', []).removeAll(resource.data.get('ok', [])).size() == 1 && request.resource.data.get('ok', []).removeAll(resource.data.get('ok', []))[0] in partyOf(p).chars && canEditSheet(request.resource.data.get('ok', []).removeAll(resource.data.get('ok', []))[0])))
          && (resource.data.get('going', '') == '' || request.resource.data.get('going', '') == resource.data.get('going', ''))
          && request.resource.data.get('handedBy', '') is string && request.resource.data.get('handedBy', '').size() <= 80;
        match /items/{i} {
          allow read: if admin() || (signedIn() && (me() in partyOf(p).people || partyMgr(partyOf(p))));
          allow write: if admin() || (signedIn() && partyMgr(partyOf(p)));
          allow update: if signedIn() && me() in partyOf(p).people && get(/databases/$(db)/documents/parties/$(p)/split/$(b)).data.open == true && resource.data.get('handed', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to', 'toName', 'shares', 'setBy', 'at', 'handed'])
            && request.resource.data.get('shares', {}) is map && request.resource.data.get('shares', {}).size() <= 12 && request.resource.data.get('shares', {}).keys().hasOnly(partyOf(p).chars)
            && (request.resource.data.to == '' || request.resource.data.to in partyOf(p).chars)
            && request.resource.data.get('toName', '') is string && request.resource.data.get('toName', '').size() <= 80;
        }
      }
      // Each character's latest initiative roll, for the DM's turn order (written by the character's own sheet).
      match /init/{c} {
        allow read: if admin() || (signedIn() && (me() in partyOf(p).people || partyMgr(partyOf(p))));
        allow write: if signedIn() && c in partyOf(p).chars && canEditSheet(c) && request.resource.data.keys().hasOnly(['v', 'at', 'n']) && request.resource.data.v is number;
        allow delete: if signedIn() && partyMgr(partyOf(p));
      }
      // The players' own chat: the DM (and co-DMs) can't read it, and only a character's owner can post as it. Nothing about it is logged, and messages are cleared
      // after 12 hours by whichever player's sheet notices them first.
      function chatter() { let d = partyOf(p); return signedIn() && me() in d.people && me() != d.dm && !(me() in d.get('mgrs', [])); }
      match /chat/{m} {
        allow read: if chatter();
        allow create: if chatter() && request.resource.data.keys().hasOnly(['at', 'by', 'c', 'n', 't', 'pn', 'pp', 'pc', 'pk']) && request.resource.data.get('pp', '').size() <= 60000 && request.resource.data.get('pn', '').size() <= 60
          && request.resource.data.by == me() && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 1000
          && request.resource.data.n is string && request.resource.data.n.size() <= 120 && request.resource.data.c in partyOf(p).chars && ownsSheet(request.resource.data.c)
          && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 3600000 && request.resource.data.get('pc', '') is string && request.resource.data.get('pc', '').size() <= 20 && request.resource.data.get('pk', false) is bool;
        allow delete: if chatter() && (resource.data.by == me() || resource.data.at < request.time.toMillis() - 43200000 || resource.data.at <= partyOf(p).get('chatClear', 0));
      }
      // Typing and read receipts: one doc per character, written only by that character's player; players read them.
      match /typing/{c} {
        allow read: if chatter();
        allow create, update: if chatter() && c in partyOf(p).chars && ownsSheet(c) && request.resource.data.by == me() && request.resource.data.c == c
          && request.resource.data.keys().hasOnly(['by', 'c', 'n', 'pp', 'pc', 'pk', 't', 'r']) && request.resource.data.t is number && request.resource.data.r is number
          && request.resource.data.n is string && request.resource.data.n.size() <= 60 && request.resource.data.get('pp', '').size() <= 60000 && request.resource.data.get('pc', '').size() <= 20 && request.resource.data.get('pk', false) is bool;
        allow delete: if chatter();
      }
      // Whispers (/whisper or /w, and /r to reply): one player's character to another's. Only the two of them can read it.
      match /whisper/{m} {
        allow read: if signedIn() && (resource.data.by == me() || resource.data.toEm == me());
        allow create: if chatter() && request.resource.data.keys().hasOnly(['at', 'by', 'c', 'n', 't', 'to', 'toEm', 'toN', 'pn', 'pp', 'pc', 'pk']) && request.resource.data.get('pp', '').size() <= 60000 && request.resource.data.get('pn', '').size() <= 60
          && request.resource.data.by == me() && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 1000
          && request.resource.data.n is string && request.resource.data.n.size() <= 120 && request.resource.data.toN is string && request.resource.data.toN.size() <= 120
          && request.resource.data.c in partyOf(p).chars && ownsSheet(request.resource.data.c)
          && request.resource.data.to in partyOf(p).chars && request.resource.data.to != request.resource.data.c
          && get(/databases/$(db)/documents/sheets/$(request.resource.data.to)).data.owner == request.resource.data.toEm
          && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 3600000 && request.resource.data.get('pc', '') is string && request.resource.data.get('pc', '').size() <= 20 && request.resource.data.get('pk', false) is bool;
        allow delete: if signedIn() && (resource.data.by == me() || resource.data.toEm == me() || resource.data.at < request.time.toMillis() - 43200000);
      }
    }
    // An invite link: /join/<code> says which party (anyone signed in who has the link can look it up).
    // The picture shown when an invite link is pasted somewhere (read by the invite-link worker, so anyone can read it).
    match /invcard/{t} {
      allow get: if true;
      allow list: if false;
      // (only the party's current invite link has a card, in at most 5 pieces, so nobody can fill the database with pictures)
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['p', 'name', 'dmName', 'n', 'img', 'k', 'at'])
        && t == partyOf(request.resource.data.p).get('inv', '') && request.resource.data.get('k', 1) is int && request.resource.data.get('k', 1) <= 5
        && request.resource.data.img is string && request.resource.data.img.size() < 900000 && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && partyMgr(partyOf(request.resource.data.p)) && (resource == null || (resource.data.p == request.resource.data.p && partyMgr(partyOf(resource.data.p))));
      allow delete: if signedIn() && partyMgr(partyOf(resource.data.p));
      // the rest of a picture too big for one document
      match /part/{i} {
        allow get: if true;
        allow list: if false;
        allow create, update: if signedIn() && i.matches('[1-4]') && request.resource.data.keys().hasOnly(['img']) && request.resource.data.img is string
          && request.resource.data.img.size() < 900000 && partyMgr(partyOf(get(/databases/$(db)/documents/invcard/$(t)).data.p));
        allow delete: if signedIn() && partyMgr(partyOf(get(/databases/$(db)/documents/invcard/$(t)).data.p));
      }
    }
    match /invites/{t} {
      allow get: if signedIn();
      allow list: if false;
      // someone who just joined with the link counts themselves (one at a time, never past its number of players)
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) && request.resource.data.used == resource.data.get('used', 0) + 1
        && resource.data.get('max', 0) > 0 && resource.data.get('used', 0) < resource.data.max
        && getAfter(/databases/$(db)/documents/parties/$(resource.data.p)).data.get('via', '') == t && me() in getAfter(/databases/$(db)/documents/parties/$(resource.data.p)).data.people
        && getAfter(/databases/$(db)/documents/parties/$(resource.data.p)).data.chars.size() == partyOf(resource.data.p).chars.size() + 1;
      allow create, update: if admin() || (signedIn() && request.resource.data.keys().hasOnly(['p', 'name', 'dm', 'dmName', 'at', 'n', 'pic', 'max', 'used'])
        && request.resource.data.get('max', 0) is int && request.resource.data.get('max', 0) >= 0 && request.resource.data.get('max', 0) <= 50
        && (!('pic' in request.resource.data) || (request.resource.data.pic is string && request.resource.data.pic.size() < 300000))
        && request.resource.data.get('used', 0) is int && request.resource.data.get('used', 0) >= 0
        && request.resource.data.get('dm', '') == partyOf(request.resource.data.p).dm
        && partyMgr(partyOf(request.resource.data.p)) && (resource == null || (resource.data.p == request.resource.data.p && partyMgr(partyOf(resource.data.p)))));
      allow delete: if admin() || (signedIn() && partyMgr(partyOf(resource.data.p)));
    }
    // Things party members send each other (an item handed over, healing, a spell cast on them...). They wait here until
    // the character's own sheet picks them up and applies them. Only someone in the same party can send one - the DM, a
    // co-DM, or a player sending from a character in that party they can edit - and only that character's sheet reads them.
    // "from" can't be faked: it's empty (the DM themselves) or a character the sender can edit.
    function partySend(id) { let d = request.resource.data; let pd = partyOf(d.p);
      return id in pd.chars && (admin() || (d.from == '' && partyMgr(pd)) || (d.from is string && d.from in pd.chars && canEditSheet(d.from))); }
    match /sheets/{id}/inbox/{m} {
      allow create: if signedIn() && request.resource.data.by == me() && request.resource.data.keys().hasOnly(['p', 'ref', 'from', 'fromName', 'by', 'at', 'kind', 'data'])
        && request.resource.data.data is string && request.resource.data.data.size() < 400000 && partySend(id);
      allow read, delete: if signedIn() && canEditSheet(id);
      // the sender can take back (or deliver) what they sent while it's still waiting
      allow get, delete: if signedIn() && resource.data.by == me();
      allow update: if false;
    }
    match /config/admins {
      allow get: if admin();
      allow create, update, delete: if owner0();
    }
    // Accounts left out of the notice / welcome numbers (admin page, Users ... menu).
    match /config/quiet {
      allow get, create, update, delete: if admin();
    }
    // Bug reports: anyone signed in can send one (as themselves); they can read their own (to hear when it's fixed) and
    // only mark it seen. Admins read, fix, reopen and delete them.
    match /bugs/{b} {
      allow create: if signedIn() && request.resource.data.by == me() && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['sum', 'desc', 'by', 'byName', 'at', 'where', 'ch', 'ua', 'status', 'files'])
        && request.resource.data.get('files', 0) is int && request.resource.data.get('files', 0) >= 0 && request.resource.data.get('files', 0) <= 4
        && request.resource.data.sum is string && request.resource.data.sum.size() <= 200
        && request.resource.data.get('desc', '') is string && request.resource.data.get('desc', '').size() <= 20000
        && request.resource.data.get('where', '/') is string && request.resource.data.get('where', '/').matches('/[^/\\\\].{0,199}|/')
        && request.resource.data.get('ch', '') is string && request.resource.data.get('ch', '').size() <= 80
        && request.resource.data.get('ua', '') is string && request.resource.data.get('ua', '').size() <= 300
        && request.resource.data.get('byName', '') is string && request.resource.data.get('byName', '').size() <= 60;
      allow read: if admin() || (signedIn() && resource.data.by == me());
      allow update: if admin() || (signedIn() && resource.data.by == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']));
      allow delete: if admin();
      // Its attachments (up to 4, one data URL each), added by whoever sent the report, right after sending it.
      match /files/{f} {
        allow create: if signedIn() && f in ['0', '1', '2', '3'] && get(/databases/$(db)/documents/bugs/$(b)).data.by == me()
          && int(f) < get(/databases/$(db)/documents/bugs/$(b)).data.get('files', 0)
          && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'data', 'w', 'h'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.type is string && request.resource.data.type.size() <= 100
          && request.resource.data.size is number && request.resource.data.w is number && request.resource.data.h is number
          && request.resource.data.data is string && request.resource.data.data.size() <= 1000000;
        allow read: if admin() || (signedIn() && get(/databases/$(db)/documents/bugs/$(b)).data.by == me());
        allow delete: if admin();
      }
    }
    // The first-time welcome message, and the notice that's out right now (shown to a new account after the welcome):
    // anyone signed in can read them; only admins set them.
    match /config/welcome {
      allow get: if signedIn();
      allow create, update, delete: if admin();
    }
    match /config/notice {
      allow get: if signedIn();
      allow create, update, delete: if admin();
    }
    // The front page's tour video and its thumbnail (Admin → Landing video): anyone can read it, even signed out;
    // only admins set it. The thumbnail is a small picture kept in the document itself.
    match /config/landing {
      allow get: if true;
      allow create, update: if admin() && request.resource.data.get('video', '') is string && request.resource.data.get('video', '').size() <= 20
        && request.resource.data.get('poster', '') is string && request.resource.data.get('poster', '').size() <= 900000;
      allow delete: if admin();
    }
    // What's new: short updates shown in everyone's lobby (top bar on a computer, a card on a phone). Admins post them;
    // config/news holds how often the ones in rotation change.
    match /config/news {
      allow get: if signedIn();
      allow create, update, delete: if admin();
    }
    match /news/{n} {
      allow read: if signedIn();
      allow create, update: if admin() && request.resource.data.get('t', '') is string && request.resource.data.get('t', '').size() <= 200
        && request.resource.data.get('d', '') is string && request.resource.data.get('d', '').size() <= 4000;
      allow delete: if admin();
    }
    // DM's Desk: each person's own sessions and creatures, private to them.
    // A DM's Desk is the DM's own. Its co-DMs share it: a party's desk (sessions, notes) is open to that party's co-DMs, and the
    // DM's creatures, note pictures and desk items to everyone on deskshare/{em}.codms (every co-DM of a party the DM runs).
    function deskCoDM(em) { return signedIn() && exists(/databases/$(db)/documents/deskshare/$(em)) && me() in get(/databases/$(db)/documents/deskshare/$(em)).data.get('codms', []); }
    function deskPartyMgr(em, p) { let d = partyOf(p); return signedIn() && d.dm == em && me() in d.get('mgrs', []); }
    match /desks/{em} {
      allow read, write: if signedIn() && em == me();
      match /{sub}/{document=**} {
        allow read, write: if signedIn() && (em == me() || (sub in ['creatures', 'imgs', 'items'] && deskCoDM(em)));
      }
      match /party/{p} {
        allow read, write: if signedIn() && (em == me() || deskPartyMgr(em, p));
        match /{document=**} {
          allow read, write: if signedIn() && (em == me() || deskPartyMgr(em, p));
        }
      }
    }
    match /deskshare/{em} {
      allow read: if admin() || (signedIn() && em == me());
      allow write: if (admin() || (signedIn() && em == me())) && request.resource.data.keys().hasOnly(['codms', 'at'])
        && request.resource.data.codms is list && request.resource.data.codms.size() <= 300;
    }
    match /groups/{g} {
      allow get: if signedIn();
      allow create, update: if admin();
      allow list, delete: if false;
      match /chars/{c} {
        allow read: if admin() || (signedIn() && (resource == null || canSee(resource.data)));
        allow create: if admin() || (signedIn() && idOK(c) && request.resource.data.owner == me());
        allow update: if admin() || (signedIn() && (ownerWrite() || editorWrite() || leaveWrite()
          || (exists(/databases/$(db)/documents/sheets/$(c)) && (partyGrant(c, get(/databases/$(db)/documents/sheets/$(c)).data) || partyRevoke(c, get(/databases/$(db)/documents/sheets/$(c)).data)))));
        allow delete: if admin() || (signedIn() && resource.data.owner == me());
      }
    }
  }
}
