{
  "manifest_version": 3,
  "name": "Adventurer’s Tome ↔ Roll20",
  "version": "1.3.3",
  "description": "Sends rolls from your Adventurer’s Tome character sheet to your Roll20 game’s chat and reads the results back, and tells the sheet how far apart the party’s tokens are.",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://app.roll20.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/editor/*",
        "https://app.roll20.net/editor"
      ],
      "js": [
        "roll20.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.roll20.net/editor/*",
        "https://app.roll20.net/editor"
      ],
      "js": [
        "roll20-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sheet-bridge.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dnd-sheet-roll20@sheet.local",
      "strict_min_version": "121.0"
    }
  }
}
