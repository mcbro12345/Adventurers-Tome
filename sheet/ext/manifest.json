{
  "manifest_version": 3,
  "name": "Adventurer’s Tome ↔ Roll20",
  "version": "1.4.1",
  "description": "Rolls from your Adventurer’s Tome sheet in Roll20 chat, results back on the sheet, and auras that follow your tokens.",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "host_permissions": [
    "https://app.roll20.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/editor/*",
        "https://app.roll20.net/editor"
      ],
      "js": [
        "roll20.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.roll20.net/editor/*",
        "https://app.roll20.net/editor"
      ],
      "js": [
        "roll20-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://adventurers-tome.web.app/*",
        "https://dnd-character-sheets-b30c7.web.app/*",
        "https://dnd-character-sheets-b30c7.firebaseapp.com/*",
        "https://mcbro12345.github.io/*"
      ],
      "js": [
        "sheet-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dnd-sheet-roll20@sheet.local",
      "strict_min_version": "121.0"
    }
  }
}
